{
  "name": "etiquete",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "dev:gateway": "node services/gateway/server.mjs",
    "dev:service": "node services/server.mjs",
    "dev:mocks": "node scripts/mock-hub.mjs",
    "fixtures": "node scripts/export-fixtures.mjs",
    "build": "vite build --config frontend/vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,css,html,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,css,html,json,yml,yaml}\"",
    "preview": "vite preview --config frontend/vite.config.js --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  }
}
