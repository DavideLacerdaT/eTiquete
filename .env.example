POSTGRES_USER=etiquete
POSTGRES_PASSWORD=etiquete
POSTGRES_DB=etiquete
POSTGRES_PORT=5432
KAFKA_PORT=9092
NGINX_PORT=8080

# Frontend: mock (independente) ou gateway; também selecionável no Laboratório.
VITE_DATA_MODE=mock

# Cada processo escolhe o modo de cada dependência. Sem fallback silencioso.
DATA_MODE=mock
MOCK_SCENARIO=happy-path
DEPENDENCY_TIMEOUT_MS=10000
MESSAGING_MODE=mock
KAFKA_BROKERS=localhost:9092

CATALOG_MODE=mock
CATALOG_URL=http://127.0.0.1:3011
ADMISSIONS_MODE=mock
ADMISSIONS_URL=http://127.0.0.1:3012
RESERVATIONS_MODE=mock
RESERVATIONS_URL=http://127.0.0.1:3013
ORDERS_MODE=mock
ORDERS_URL=http://127.0.0.1:3014
PAYMENTS_MODE=mock
PAYMENTS_URL=http://127.0.0.1:3015
NOTIFICATIONS_MODE=mock
NOTIFICATIONS_URL=http://127.0.0.1:3016

# Ao executar vários processos com dependências simuladas, use o mesmo hub.
